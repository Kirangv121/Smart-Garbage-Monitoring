<header id="header" class="masthead" role="banner" ng-class="{&#39;headsUpGap&#39;: home.headsUp == &#39;true&#39;}">
    <div class="centerizer">
        <div class="masthead__contents">
            <h1 class="masthead__logo">
                <span style="font-size: 0; height: 0; width: 0; display: block; overflow: hidden;">Simple emoji copy and paste by JoyPixels®</span>
				<a duration="250" offset="200" du-smooth-scroll="top">
                    <img src="./gb1_files/emojicopy-logo.svg" alt="EmojiCopy from JoyPixels">
                </a>
            </h1>
            <category-list class="categories ng-isolate-scope"><section id="categorylist">
    <ul class="category-picker" role="navigation">
        <!-- ngRepeat: category in catlist.categories --><li ng-repeat="category in catlist.categories" class="ng-scope">
            <a class="category-picker__button" title="Smileys &amp; People" ng-click="catlist.gotoCategory(category.name)" offset="250" du-scrollspy="people">
                <i class="icon-people"></i>
            </a>
        </li><!-- end ngRepeat: category in catlist.categories --><li ng-repeat="category in catlist.categories" class="ng-scope">
            <a class="category-picker__button" title="Animals &amp; Nature" ng-click="catlist.gotoCategory(category.name)" offset="250" du-scrollspy="nature">
                <i class="icon-nature"></i>
            </a>
        </li><!-- end ngRepeat: category in catlist.categories --><li ng-repeat="category in catlist.categories" class="ng-scope">
            <a class="category-picker__button" title="Food &amp; Drink" ng-click="catlist.gotoCategory(category.name)" offset="250" du-scrollspy="food">
                <i class="icon-food"></i>
            </a>
        </li><!-- end ngRepeat: category in catlist.categories --><li ng-repeat="category in catlist.categories" class="ng-scope">
            <a class="category-picker__button" title="Activity" ng-click="catlist.gotoCategory(category.name)" offset="250" du-scrollspy="activity">
                <i class="icon-activity"></i>
            </a>
        </li><!-- end ngRepeat: category in catlist.categories --><li ng-repeat="category in catlist.categories" class="ng-scope">
            <a class="category-picker__button" title="Travel &amp; Places" ng-click="catlist.gotoCategory(category.name)" offset="250" du-scrollspy="travel">
                <i class="icon-travel"></i>
            </a>
        </li><!-- end ngRepeat: category in catlist.categories --><li ng-repeat="category in catlist.categories" class="ng-scope">
            <a class="category-picker__button active" title="Objects" ng-click="catlist.gotoCategory(category.name)" offset="250" du-scrollspy="objects">
                <i class="icon-objects"></i>
            </a>
        </li><!-- end ngRepeat: category in catlist.categories --><li ng-repeat="category in catlist.categories" class="ng-scope">
            <a class="category-picker__button" title="Symbols" ng-click="catlist.gotoCategory(category.name)" offset="250" du-scrollspy="symbols">
                <i class="icon-symbols"></i>
            </a>
        </li><!-- end ngRepeat: category in catlist.categories --><li ng-repeat="category in catlist.categories" class="ng-scope">
            <a class="category-picker__button" title="Flags" ng-click="catlist.gotoCategory(category.name)" offset="250" du-scrollspy="flags">
                <i class="icon-flags"></i>
            </a>
        </li><!-- end ngRepeat: category in catlist.categories -->
    </ul>
</section></category-list>
        </div>
    </div>
</header>


<!--/////////// TOOLBAR ////////////-->
<div class="toolbar__wrap" id="toolbar" ng-class="{&#39;headsUpTop&#39;: home.headsUp == &#39;true&#39;}">
    <div class="full-bg">
        <div class="centerizer">
            <div class="toolbar" id="search">
                <emoji-search querytext="home.querytext" class="toolbar__search ng-isolate-scope"><div itemscope="" itemtype="https://schema.org/WebSite">
    <meta itemprop="url" content="https://www.emojicopy.com/">
    <form role="search" itemprop="potentialAction" itemscope="" itemtype="https://schema.org/SearchAction" class="ng-pristine ng-valid">
        <meta itemprop="target" content="https://www.emojicopy.com/?q={search}">
        <span class="toolbar__search__icon"></span>
        <input class="toolbar__search__input ng-pristine ng-untouched ng-valid ng-empty" type="text" name="search" id="mainSearchInput" itemprop="query-input" placeholder="Search" value="" autocomplete="off" ng-model="search.querytext" ng-model-options="{debounce: 250}" ng-change="search.trackSearch()">
        <button role="button" class="toolbar__search__reset faded" ng-click="search.querytext = &#39;&#39;" ng-class="{&#39;faded&#39;: search.querytext == &#39;&#39;}"><i class="icon-close"></i></button>
    </form>
</div></emoji-search>
                <div class="toolbar__right">
                    <button class="ui-toggle pad-right clipboard-toggle" ng-click="home.toggleStatusBar()" ng-class="{ &#39;active&#39; : home.statusOpen == true, &#39;pinned&#39; : $root.isPinned === &#39;true&#39; &amp;&amp; home.statusOpen == true }">
                        <i class="ui-toggle__icon icon-clipboard"></i>
                    </button>
                    <diversity-selector class="toolbar__diversity ng-isolate-scope"><div class="ui-option" ng-class="{ &#39;active&#39; : diversity.showMenu == true }" tw-click-outside="diversity.closeMenu()">
    <button class="ui-toggle" ng-click="diversity.toggleMenu()">
        <span class="ui-toggle__flex">
            <span class="ui-toggle__dot tone-0" ng-class="diversity.presetDiversity"></span>
        </span>
    </button>
    <div class="ui-menu ui-menu--diversity">
        <ul class="skintones" role="toolbar">
            <li>
                <button ng-class="{ &#39;active&#39;: diversity.presetDiversity == &#39;tone-0&#39; }" ng-click="diversity.selectDiversity(&#39;tone-0&#39;)" role="button" data-tone="0" class="skintones__option active">
                    <span class="skintones__dot tone-0"></span>
                </button>
            </li>
            <li>
                <button ng-class="{ &#39;active&#39;: diversity.presetDiversity == &#39;tone-1&#39; }" ng-click="diversity.selectDiversity(&#39;tone-1&#39;)" role="button" data-tone="1" class="skintones__option">
                    <span class="skintones__dot tone-1"></span>
                </button>
            </li>
            <li>
                <button ng-class="{ &#39;active&#39;: diversity.presetDiversity == &#39;tone-2&#39; }" ng-click="diversity.selectDiversity(&#39;tone-2&#39;)" role="button" data-tone="2" class="skintones__option">
                    <span class="skintones__dot tone-2"></span>
                </button>
            </li>
            <li>
                <button ng-class="{ &#39;active&#39;: diversity.presetDiversity == &#39;tone-3&#39; }" ng-click="diversity.selectDiversity(&#39;tone-3&#39;)" role="button" data-tone="3" class="skintones__option">
                    <span class="skintones__dot tone-3"></span>
                </button>
            </li>
            <li>
                <button ng-class="{ &#39;active&#39;: diversity.presetDiversity == &#39;tone-4&#39; }" ng-click="diversity.selectDiversity(&#39;tone-4&#39;)" role="button" data-tone="4" class="skintones__option">
                    <span class="skintones__dot tone-4"></span>
                </button>
            </li>
            <li>
                <button ng-class="{ &#39;active&#39;: diversity.presetDiversity == &#39;tone-5&#39; }" ng-click="diversity.selectDiversity(&#39;tone-5&#39;)" role="button" data-tone="5" class="skintones__option">
                    <span class="skintones__dot tone-5"></span>
                </button>
            </li>
        </ul>
    </div>
</div></diversity-selector>
                    <settings class="ng-isolate-scope"><div class="ui-option ui-option--settings" ng-class="{ &#39;active&#39; : settings.showMenu == true }" tw-click-outside="settings.closeMenu()">
	<button class="ui-toggle" ng-click="settings.toggleMenu()">
		<span class="ui-toggle__flex">
			<i class="ui-toggle__icon icon-settings"></i>
		</span>
	</button>
	<div class="ui-menu ui-menu--settings">
		<div class="ui-menu__set">
			<span class="ui-menu__set__title">Emoji Size</span>
			<div class="ui-menu__selector">
				<!-- ngRepeat: size in settings.sizes --><button class="ui-menu__button ng-binding ng-scope" ng-repeat="size in settings.sizes" ng-class="{ &#39;active&#39; : $root.emojiSize == size.size }" ng-click="settings.setSize(size.size)">
					Small
				</button><!-- end ngRepeat: size in settings.sizes --><button class="ui-menu__button ng-binding ng-scope active" ng-repeat="size in settings.sizes" ng-class="{ &#39;active&#39; : $root.emojiSize == size.size }" ng-click="settings.setSize(size.size)">
					Medium
				</button><!-- end ngRepeat: size in settings.sizes --><button class="ui-menu__button ng-binding ng-scope" ng-repeat="size in settings.sizes" ng-class="{ &#39;active&#39; : $root.emojiSize == size.size }" ng-click="settings.setSize(size.size)">
					Large
				</button><!-- end ngRepeat: size in settings.sizes -->
			</div>
		</div>
		<div class="ui-menu__set">
			<span class="ui-menu__set__title">Emoji Type</span>
			<div class="ui-menu__selector">
				<!-- ngRepeat: type in settings.types --><button class="ui-menu__button ng-binding ng-scope active" ng-repeat="type in settings.types" ng-class="{ &#39;active&#39; : $root.emojiType === type.slug }" ng-click="settings.setType(type.slug)">
					Sprites
				</button><!-- end ngRepeat: type in settings.types --><button class="ui-menu__button ng-binding ng-scope" ng-repeat="type in settings.types" ng-class="{ &#39;active&#39; : $root.emojiType === type.slug }" ng-click="settings.setType(type.slug)">
					Web Font
				</button><!-- end ngRepeat: type in settings.types --><button class="ui-menu__button ng-binding ng-scope" ng-repeat="type in settings.types" ng-class="{ &#39;active&#39; : $root.emojiType === type.slug }" ng-click="settings.setType(type.slug)">
					Native
				</button><!-- end ngRepeat: type in settings.types -->
			</div>
		</div>
	</div>
</div></settings>
                </div>
            </div>
        </div>
    </div>

    <!--/////////// COPYBAR ///////////-->
    <emoji-status-bar id="statusbar" querytext="home.querytext" class="ng-isolate-scope"><div class="status-bar status-bar-wrap" ng-class="{ &#39;active&#39; : status.display === true }">
    <div class="status-bar-container" ng-class="{ &#39;pinned&#39; : $root.isPinned === &#39;true&#39; }">
        <div class="status-bar__pin" ng-click="status.togglePin()" ng-class="{ &#39;active&#39; : $root.isPinned === &#39;true&#39; }"></div>
        <div class="status-bar__message">
            <input type="text" id="copyinput" placeholder="click emoji or combine with text" class="__input ng-pristine ng-valid ng-touched ng-empty" ng-model="status.copytext">
            <button type="button" role="button" class="__reset" ng-click="status.clearStatus();">
                <i class="icon-close"></i>
            </button>
            <!--<span class="status-bar__clear" ng-click="status.clearStatus();">clear</span>-->
            <button id="copybutton" data-clipboard-target="#copyinput" type="button" class="__copy-v2 ng-binding" ng-class="{ &#39;active&#39; : status.copytext, &#39;copied&#39; : status.copied == true }">
                copy
            </button>
        </div>
    </div>
</div></emoji-status-bar>
</div>


<!--/////////// MAIN ////////////-->
<main class="main" role="main" ng-class="{&#39;headsUpPad&#39;: home.headsUp == &#39;true&#39;}">

    <div class="centerizer" id="top">

        <div class="emojis">
            <!-- RECENTS -->
            <emoji-list ng-switch="expression" querytext="home.querytext" class="ng-isolate-scope"><div id="emoji" ng-class="{ &#39;loading&#39; : $root.loading == true }" style="position: relative;" class="">
    <div class="loader">
		<div class="loader__animation">
			<img src="./gb1_files/cyclone.png" alt="loading">
		</div>
	</div>
	<!-- Emojicopy ATF Leaderboard -->
